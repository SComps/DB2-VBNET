<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Db2Spufi.Core.Models;assembly=Db2Spufi.Core"
        x:Class="Db2Spufi.Avalonia.ConnectionDialog"
        Title="Db2 Connection Profiles"
        Width="740" Height="580"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid Margin="15" ColumnDefinitions="240,15,*">
        <!-- Left: Profile List -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
            <TextBlock Grid.Row="0" Text="Saved Profiles:" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox Name="LstProfiles" Grid.Row="1" SelectionMode="Single"
                     SelectionChanged="OnProfileSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ConnectionProfile">
                        <StackPanel Orientation="Vertical" Margin="2">
                            <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                            <TextBlock Text="{Binding Server}" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2" ColumnDefinitions="*,10,*" Margin="0,10,0,0">
                <Button Grid.Column="0" Name="BtnNew" Content="+ New" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnNewClick"/>
                <Button Grid.Column="2" Name="BtnDelete" Content="Delete" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnDeleteClick"/>
            </Grid>
        </Grid>

        <!-- Right: Profile Parameters & Actions -->
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*,Auto">
            <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock Text="Connection Parameters" FontWeight="SemiBold" Margin="0,0,0,4"/>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="Profile Name:" VerticalAlignment="Center"/>
                        <TextBox Name="TxtName" Grid.Column="1"/>
                    </Grid>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="Server (Host/IP):" VerticalAlignment="Center"/>
                        <TextBox Name="TxtServer" Grid.Column="1"/>
                    </Grid>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="Port:" VerticalAlignment="Center"/>
                        <NumericUpDown Name="NumPort" Grid.Column="1" Minimum="1" Maximum="65535" Value="8103" FormatString="0" HorizontalAlignment="Left" Width="120"/>
                    </Grid>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="Location / DB:" VerticalAlignment="Center"/>
                        <TextBox Name="TxtDatabase" Grid.Column="1"/>
                    </Grid>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="User ID:" VerticalAlignment="Center"/>
                        <TextBox Name="TxtUser" Grid.Column="1"/>
                    </Grid>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="Password:" VerticalAlignment="Center"/>
                        <TextBox Name="TxtPassword" Grid.Column="1" PasswordChar="*"/>
                    </Grid>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="Current SQLID:" VerticalAlignment="Center"/>
                        <TextBox Name="TxtCurrentSqlId" Grid.Column="1"/>
                    </Grid>

                    <CheckBox Name="ChkDefault" Margin="120,4,0,0" Content="Default Connection Profile"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,12,0,8" HorizontalAlignment="Right">
                <Button Name="BtnSave" Content="Save Profile" Width="100" HorizontalContentAlignment="Center" Click="OnSaveClick"/>
                <Button Name="BtnTest" Content="Test Connection" Width="120" HorizontalContentAlignment="Center" Click="OnTestClick"/>
                <Button Name="BtnUseClose" Content="Use &amp; Close" Width="100" HorizontalContentAlignment="Center" Classes="accent" Click="OnUseCloseClick"/>
            </StackPanel>

            <!-- Test status label -->
            <TextBlock Name="LblTestResult" Grid.Row="2" Margin="0,4,0,4" TextWrapping="Wrap" FontWeight="SemiBold"/>

            <!-- Diagnostics log / bind button -->
            <Grid Grid.Row="3" Margin="0,4,0,0" RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,0,0,4">
                    <Button Name="BtnBindPackages" Content="Bind CLI Packages..." IsVisible="False" Click="OnBindPackagesClick"/>
                </StackPanel>
                <TextBox Name="TxtLog" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" TextWrapping="Wrap"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
