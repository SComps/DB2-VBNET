<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Price3DManager</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      PublishAot and PublishSingleFile are intentionally NOT set.
      IBM.Data.Db2 calls Assembly.CodeBase internally, which throws
      NotSupportedException when bundled as a single-file binary.
      Use the scripts in the scripts/ folder to publish.
    -->
  </PropertyGroup>

  <!--
    IBM Db2 NuGet packages are platform-specific.
    Use the Linux package when building ON Linux, OR when cross-publishing
    TO a Linux runtime from Windows (RuntimeIdentifier starts with "linux").
    Otherwise use the Windows package.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And !$(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="Net.IBM.Data.Db2" Version="10.0.0.300" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) Or $(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="Net.IBM.Data.Db2-lnx" Version="10.0.0.300" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="1.17.1" />
  </ItemGroup>

</Project>
