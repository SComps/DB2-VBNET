<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Db2Spufi.WinForms</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <StartupObject>Sub Main</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Db2Spufi.Core\Db2Spufi.Core.vbproj" />
  </ItemGroup>

  <!-- Include Net.IBM.Data.Db2 so clidriver is copied to the application output directory -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Net.IBM.Data.Db2" Version="10.0.0.300" />
  </ItemGroup>

</Project>
