<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Db2Spufi.Core</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>1.0.0</Version>
    <Authors>Scott / SComps</Authors>
    <Description>IBM Db2 SPUFI execution engine, profile management, and LINQ to Db2 library for .NET 10 applications.</Description>
  </PropertyGroup>

  <!--
    IBM Db2 NuGet packages are platform-specific.
    Use Windows package on Windows, Linux package on Linux.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And !$(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="Net.IBM.Data.Db2" Version="10.0.0.300" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) Or $(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="Net.IBM.Data.Db2-lnx" Version="10.0.0.300" />
  </ItemGroup>

</Project>
